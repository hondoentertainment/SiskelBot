{
  "id": "example",
  "name": "Example Eval Set",
  "description": "Sample eval cases for chat, task planning, golden traces, and skippable live-agent templates (Phases 93–95).",
  "cases": [
    {
      "id": "greeting",
      "prompt": "Say hello in one word.",
      "target": "chat",
      "expectedContains": "hello"
    },
    {
      "id": "task-plan-simple",
      "prompt": "Create a plan to water the plants.",
      "target": "task",
      "expectedJson": ["type", "name", "steps"]
    },
    {
      "id": "trace-tool-order",
      "target": "trace",
      "trace": [
        { "name": "get_recipe", "arguments": { "recipeId": "r1" } },
        { "name": "list_context", "arguments": {} }
      ],
      "expectedToolSequence": ["get_recipe", "list_context"]
    },
    {
      "id": "trace-tool-multiset",
      "target": "trace",
      "trace": [
        { "tool": "search_context", "arguments": { "query": "docs" } },
        { "name": "list_context", "args": {} }
      ],
      "expectedToolNames": ["list_context", "search_context"]
    },
    {
      "id": "trace-tool-args",
      "target": "trace",
      "trace": [
        { "name": "search_context", "arguments": { "query": "hello", "workspace": "default" } }
      ],
      "expectedToolCalls": [
        { "name": "search_context", "requiredArgKeys": ["query"] }
      ]
    },
    {
      "id": "template-live-agent-tools",
      "skip": true,
      "skipReason": "Requires live LLM with tools; set skip:false to run manually. See also data/eval-sets/agent-outcome-examples.json.",
      "prompt": "Use list_context once, then summarize in one sentence.",
      "target": "chat",
      "agentMode": true,
      "agentOptions": { "workspace": "default", "allowExecution": false },
      "expectedMinAgentActivityToolCalls": 1,
      "expectedAgentActivityToolNames": ["list_context"],
      "expectedContains": "."
    },
    {
      "id": "template-chat-request-defaults",
      "skip": true,
      "skipReason": "Demonstrates set-level chatRequestDefaults; enable for manual staging runs only.",
      "prompt": "Reply with OK.",
      "target": "chat",
      "expectedContains": "OK"
    }
  ],
  "chatRequestDefaults": {
    "temperature": 0.2,
    "max_tokens": 64
  }
}
