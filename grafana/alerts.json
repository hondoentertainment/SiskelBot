{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "SiskelBot Alerts",
      "folder": "SiskelBot",
      "interval": "1m",
      "rules": [
        {
          "uid": "siskelbot-error-rate-spike",
          "title": "Error Rate Spike (5xx > 5%)",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "${DS_PROMETHEUS}",
              "model": {
                "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))",
                "refId": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "${DS_PROMETHEUS}",
              "model": {
                "expr": "sum(rate(http_requests_total[5m]))",
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "queryType": "",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "math",
                "expression": "($A / $B) * 100 > 5",
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "HTTP 5xx error rate has exceeded 5% of total requests over the last 5 minutes.",
            "description": "Current 5xx rate: {{ $values.A }} errors/s out of {{ $values.B }} total requests/s. Investigate server logs and backend health immediately."
          },
          "labels": {
            "severity": "critical",
            "service": "siskelbot",
            "category": "availability"
          }
        },
        {
          "uid": "siskelbot-latency-degradation",
          "title": "Latency Degradation (p95 > 5s)",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "${DS_PROMETHEUS}",
              "model": {
                "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
                "refId": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "refId": "B",
                "conditions": [
                  {
                    "evaluator": { "type": "gt", "params": [5] },
                    "operator": { "type": "and" },
                    "reducer": { "type": "last" }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Request latency p95 has exceeded 5 seconds over the last 5 minutes.",
            "description": "Current p95 latency: {{ $values.A }}s. This may indicate backend slowness, resource exhaustion, or a spike in complex agent requests."
          },
          "labels": {
            "severity": "warning",
            "service": "siskelbot",
            "category": "performance"
          }
        },
        {
          "uid": "siskelbot-quota-exhaustion",
          "title": "Quota Exhaustion (workspace > 90%)",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "${DS_PROMETHEUS}",
              "model": {
                "expr": "(siskelbot_workspace_tokens_used / siskelbot_workspace_quota_limit) * 100",
                "refId": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "refId": "B",
                "conditions": [
                  {
                    "evaluator": { "type": "gt", "params": [90] },
                    "operator": { "type": "and" },
                    "reducer": { "type": "last" }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "A workspace has exceeded 90% of its token quota.",
            "description": "Workspace {{ $labels.workspace }} is at {{ $values.A }}% of its quota limit. Consider increasing the quota or notifying the workspace owner. If no siskelbot_workspace_tokens_used metric is exported, add custom instrumentation per lib/quotas.js or monitor via the admin API (/api/admin/quotas)."
          },
          "labels": {
            "severity": "warning",
            "service": "siskelbot",
            "category": "quota"
          }
        },
        {
          "uid": "siskelbot-circuit-breaker-open",
          "title": "Circuit Breaker Open",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "${DS_PROMETHEUS}",
              "model": {
                "expr": "experimentagent_circuit_breaker_open",
                "refId": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "refId": "B",
                "conditions": [
                  {
                    "evaluator": { "type": "gt", "params": [0] },
                    "operator": { "type": "and" },
                    "reducer": { "type": "last" }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "A circuit breaker has opened for a backend provider.",
            "description": "Circuit breaker for backend {{ $labels.backend }} is OPEN. Requests to this backend are being short-circuited with 503 responses. The breaker will auto-reset after the cooldown period (CIRCUIT_BREAKER_COOLDOWN_MS, default 30s)."
          },
          "labels": {
            "severity": "critical",
            "service": "siskelbot",
            "category": "availability"
          }
        },
        {
          "uid": "siskelbot-agent-tool-timeout",
          "title": "Agent Tool Timeouts (> 10/min)",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": { "from": 60, "to": 0 },
              "datasourceUid": "${DS_PROMETHEUS}",
              "model": {
                "expr": "sum(increase(siskelbot_agent_tool_timeouts_total[1m]))",
                "refId": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": { "from": 60, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "refId": "B",
                "conditions": [
                  {
                    "evaluator": { "type": "gt", "params": [10] },
                    "operator": { "type": "and" },
                    "reducer": { "type": "last" }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "1m",
          "annotations": {
            "summary": "Agent tool timeouts have exceeded 10 per minute.",
            "description": "{{ $values.A }} tool timeouts in the last minute. Affected tools: check siskelbot_agent_tool_timeouts_total by tool label. This may indicate slow external services, network issues, or undersized timeout configuration."
          },
          "labels": {
            "severity": "warning",
            "service": "siskelbot",
            "category": "agent"
          }
        },
        {
          "uid": "siskelbot-webhook-dlq-growth",
          "title": "Webhook DLQ Growth (size > 50)",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "${DS_PROMETHEUS}",
              "model": {
                "expr": "siskelbot_webhook_dlq_size",
                "refId": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "refId": "B",
                "conditions": [
                  {
                    "evaluator": { "type": "gt", "params": [50] },
                    "operator": { "type": "and" },
                    "reducer": { "type": "last" }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Webhook dead-letter queue has grown beyond 50 entries.",
            "description": "DLQ size: {{ $values.A }}. Failed webhook deliveries are accumulating. Investigate target endpoints for connectivity or authorization issues. Review DLQ entries via the admin API and retry or purge as needed."
          },
          "labels": {
            "severity": "warning",
            "service": "siskelbot",
            "category": "webhooks"
          }
        }
      ]
    }
  ]
}
