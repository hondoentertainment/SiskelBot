# Managed by Ansible -- do not edit manually.
# Reverse proxy for SiskelBot with WebSocket support.

upstream siskelbot_backend {
    server 127.0.0.1:{{ siskelbot_port }};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ siskelbot_domain }};

    # ACME challenge (certbot will modify/augment this file for SSL)
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    {% if not enable_ssl | bool %}
    # Plain HTTP proxy when SSL disabled
    client_max_body_size {{ nginx_client_max_body_size }};

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1024;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;

    location / {
        proxy_pass http://siskelbot_backend;
        proxy_http_version 1.1;

        # WebSocket upgrade
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Streaming support (disable buffering for SSE)
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout {{ nginx_proxy_read_timeout }};
        proxy_send_timeout {{ nginx_proxy_send_timeout }};
        proxy_connect_timeout 60s;
    }
    {% else %}
    # Redirect all other HTTP traffic to HTTPS (certbot also manages this)
    location / {
        return 301 https://$host$request_uri;
    }
    {% endif %}
}

{% if enable_ssl | bool %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ siskelbot_domain }};

    # SSL certificate paths (populated by certbot after first run)
    ssl_certificate /etc/letsencrypt/live/{{ siskelbot_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ siskelbot_domain }}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ siskelbot_domain }}/chain.pem;

    # Modern TLS config
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    client_max_body_size {{ nginx_client_max_body_size }};

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1024;

    # Security headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;

    location / {
        proxy_pass http://siskelbot_backend;
        proxy_http_version 1.1;

        # WebSocket upgrade
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Streaming support (disable buffering for SSE)
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout {{ nginx_proxy_read_timeout }};
        proxy_send_timeout {{ nginx_proxy_send_timeout }};
        proxy_connect_timeout 60s;
    }
}
{% endif %}
