# Managed by Ansible -- do not edit manually.
# Changes will be overwritten on next playbook run.

NODE_ENV={{ siskelbot_node_env }}
PORT={{ siskelbot_port }}
HOST=127.0.0.1
LOG_LEVEL={{ siskelbot_log_level }}

# ----- Backend -----
BACKEND={{ siskelbot_backend }}
{% if siskelbot_backend == 'ollama' %}
OLLAMA_URL={{ siskelbot_ollama_url }}
{% elif siskelbot_backend == 'vllm' %}
VLLM_URL={{ siskelbot_vllm_url }}
{% elif siskelbot_backend == 'openai' %}
OPENAI_API_KEY={{ siskelbot_openai_api_key }}
{% endif %}

# ----- Auth / secrets -----
API_KEY={{ siskelbot_api_key }}
ADMIN_API_KEY={{ siskelbot_admin_api_key }}
SESSION_SECRET={{ siskelbot_session_secret }}

# ----- Storage -----
STORAGE_BACKEND={{ siskelbot_storage_backend }}
STORAGE_PATH={{ siskelbot_data_dir }}
{% if enable_postgres | bool and siskelbot_storage_backend == 'postgres' %}
DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}
{% endif %}

# ----- Redis -----
{% if enable_redis | bool %}
REDIS_URL=redis://:{{ redis_password }}@{{ redis_bind }}:{{ redis_port }}
{% endif %}

# ----- Observability -----
ENABLE_METRICS={{ siskelbot_enable_metrics }}

# ----- Public URL -----
PUBLIC_URL=https://{{ siskelbot_domain }}
