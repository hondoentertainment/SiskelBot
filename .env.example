# Backend: ollama | vllm | openai (default: ollama)
BACKEND=ollama

# Docker (Phase 35): When using docker-compose with local Ollama, use OLLAMA_URL=http://ollama:11434.
# Production (Vercel): Set BACKEND=openai, OPENAI_API_KEY, and API_KEY. Ollama/vLLM localhost won't work.

# Ollama (when BACKEND=ollama) - default for local dev
OLLAMA_URL=http://localhost:11434

# vLLM (when BACKEND=vllm)
VLLM_URL=http://localhost:8000

# OpenAI (when BACKEND=openai) - required for OpenAI
# OPENAI_API_KEY=sk-...

# Server
PORT=3000
# LISTEN_HOST=127.0.0.1     # Bind HTTP server to this host only (desktop app sets this automatically)

# Desktop (npm run desktop) — optional overrides when launching Electron from a shell:
# DESKTOP_PORT=38447         # Default embedded server port (stable OAuth redirects)
# NODE_BINARY=node           # Path to Node if not on PATH
# DESKTOP_DEBUG=1            # Forward server stdout/stderr to the terminal

# Optional: protect /v1/chat/completions with API key

# Phase 38: CLI client (optional; for npx . / siskelbot commands)
# SISKELBOT_URL=http://localhost:3000
# SISKELBOT_API_KEY=            # Or use API_KEY (same as deployment key)
# Production (Vercel): Strongly recommended. Set API_KEY in Vercel env vars.
# API_KEY=your-secret-key

# Rate limiting (optional)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60
# RATE_LIMIT_MAX_PER_USER=100   # Phase 21: Per-user limit when auth configured (default: RATE_LIMIT_MAX)

# Phase 21: Per-workspace token quotas (optional)
# QUOTA_TOKENS_PER_WORKSPACE=100000   # Tokens per workspace per period. When unset, no quota enforcement.
# QUOTA_WORKSPACE_PERIOD_DAYS=30      # Quota period in days (default: 30)
# QUOTA_ADMIN_USER_IDS=user1,user2    # Comma-separated userIds that bypass quota

# Phase 25: Admin Dashboard
# ADMIN_API_KEY=...                  # Protects /admin and /api/admin/*. Or use QUOTA_ADMIN_USER_IDS (OAuth/session).

# Phase 13: Observability & Cost Control - optional usage budget alert
# When total tokens in rolling window exceeds this, responses include X-Usage-Alert: 1
# USAGE_ALERT_TOKENS=1000000

# Phase 18: Conversation Analytics - cost estimation (OpenAI only; Ollama/vLLM = local)
# ANALYTICS_COST_PER_1K_INPUT=0.002   # $ per 1K input tokens (default: gpt-4o-mini approx)
# ANALYTICS_COST_PER_1K_OUTPUT=0.006  # $ per 1K output tokens

# Phase 14 + 30: User Authentication & Workspaces
# USER_API_KEYS=key1:user1,key2:user2   # User API keys. Phase 30: key1:user1:read,write or key2:user2:admin (key:userId:scopes). Keys without scopes default to read,write.
# API_KEY_SCOPES=read,write            # Phase 30: Scopes for deployment API_KEY (default: read,write). Options: read, write, admin, embed.
# RATE_LIMIT_PER_KEY=60               # Phase 30: Optional per-key rate limit (req/min) when set.
# Or use data/users.json: { "key1": "user1" } or { "users": [{ "apiKey": "k", "userId": "u" }] }
# When not set: anonymous user, single default workspace (backward compatible).

# Phase 19: OAuth & SSO
# GITHUB_CLIENT_ID=...            # GitHub OAuth App client ID
# GITHUB_CLIENT_SECRET=...        # GitHub OAuth App client secret
# GOOGLE_CLIENT_ID=...            # Google OAuth client ID
# GOOGLE_CLIENT_SECRET=...        # Google OAuth client secret
# SESSION_SECRET=...              # Required for OAuth session persistence. Use a long random string in production.
# BASE_URL=https://your-domain.com  # For production OAuth callbacks. Default: http://localhost:PORT in dev.

# Phase 15: Agentic Autonomy Mode
# ALLOW_RECIPE_STEP_EXECUTION=1   # Enable execute_step tool (build, deploy). Requires client "Allow recipe step execution" toggle.
# MAX_AGENT_ITERATIONS=5          # Max tool-call loop iterations (default: 5)
# ENABLE_AGENT_SWARM=1            # Enable multi-agent swarm mode. When set, client can use swarm mode (researcher + executor + synthesizer).
# SWARM_PARALLEL_AGENTS=1        # Phase 78: Always run researcher + executor in parallel (unless client sends agentOptions.parallelAgents: false).
# SWARM_CLIENT_SPECIALISTS=1     # Phase 90: Allow client to send agentOptions.swarmSpecialists (checked roster); takes precedence over parallel/intent when non-empty after validation.
# SWARM_MAX_SPECIALISTS=8        # Phase 90: Max specialists per swarm from client roster (clamped 1–12 server-side).
# SWARM_SPECIALISTS_ALLOWLIST=researcher,executor   # Phase 91: Only these specialist names may run in swarm (LLM + legacy /v1/swarm); unset = all non-synthesizer specialists allowed.
# MAX_AGENT_ITERATIONS=5              # Max tool-loop iterations per agent run and per swarm specialist (ceiling for client requests).
# AGENT_MAX_ITERATIONS_IGNORE_CLIENT=1 # Phase 92: Ignore agentOptions.maxIterations; always use MAX_AGENT_ITERATIONS.

# Phases 79–88: Agent capabilities (multi-agent swarm uses same envs for per-specialist loops)
# agentOptions.toolChoice / agentOptions.requiredToolSequence / agentOptions.responseFormat on POST /v1/chat/completions
# MAX_AGENT_TOOL_CALLS=30       # Phase 80: Stop after this many tool executions (0 = unlimited).
# AGENT_MAX_WALL_MS=120000       # Phase 80: Wall-clock budget per agent/swarm specialist run (0 = unlimited). Header X-Agent-Truncated.
# AGENT_PLAN_REFLECT=1          # Phase 83: After a successful agent loop, append one reflection paragraph from the LLM.
# STREAM_SWARM_SYNTH=1          # Phase 86: Stream synthesizer tokens over SSE instead of buffering (swarm mode).
# AGENT_FETCH_ALLOWLIST=        # Phase 85: Comma hosts or URL prefixes for fetch_allowed_url tool; falls back to KNOWLEDGE_URL_ALLOWLIST if unset.
# AGENT_FETCH_MAX_BYTES=262144
# AGENT_FETCH_TIMEOUT_MS=12000
# AGENT_FETCH_MAX_OUTPUT_CHARS=24000
# SPECIALISTS_EXTRA_PATH=./data/specialists-extra.json   # Phase 84: Extra swarm specialists (JSON array or { specialists: [...] }).
# AGENT_HOOKS_MODULE=./data/agent-hooks.mjs              # Phase 88: Optional ESM exporting beforeToolCall / afterToolCall.
# AGENT_TOOLS_ALLOWLIST=search_context,list_context      # Phase 89: Only these tools are advertised and executable (comma-separated names).

# Phase 24: Backup & Restore
# BACKUP_ADMIN_KEY=...            # Protects backup/restore API and GET /api/backup/cron. Pass via ?secret= for cron.
# BACKUP_MAX_RETAINED=7           # Max backups to keep (default: 7)

# Phase 16: Scheduled & Automated Recipes
# ENABLE_SCHEDULED_RECIPES=1      # Enable in-process cron scheduler (local). When set, node-cron runs recipes per schedule.
# CRON_SECRET=...                 # Optional; protects GET /api/cron for Vercel Cron. Pass via Authorization: Bearer <secret> or ?secret=.

# Phase 17: Plugins & Extensions
# ALLOW_WEBHOOK_ACTIONS=1         # Enable webhook action (POST to URL). Requires HTTPS, rate-limited 5/min per URL.
# PLUGINS_PATH=./plugins           # Optional; path to plugins dir containing config.json. Default: ./plugins.

# Phase 22: Event Webhooks & Notifications
# ALLOW_WEBHOOK_LOCALHOST=1       # Allow http://localhost and private IPs for webhook URLs (dev only).

# Phase 18: Conversation Analytics & Insights (optional cost estimation for OpenAI)
# ANALYTICS_COST_PER_1K_INPUT=0.002   # $ per 1K input tokens (default: gpt-4o-mini approx)
# ANALYTICS_COST_PER_1K_OUTPUT=0.006 # $ per 1K output tokens. Ollama/vLLM = local ($0).

# Toolchain Integration Hub (Phase 4) - optional. Tokens stay server-side; never exposed to client.
# GITHUB_TOKEN=ghp_...  # For /api/github/repos, /api/github/repo/:owner/:repo, /api/github/issues/:owner/:repo
# VERCEL_TOKEN=...      # For /api/vercel/deployments, /api/vercel/projects

# Phase 35–39: Production Phases
# ENABLE_CSP=1                  # Phase 35: Enable Content-Security-Policy in production (report-only unless CSP_ENFORCE=1)
# CSP_ENFORCE=1                 # Phase 35: Enforce CSP (block violations). Use after validating report-only.
# CIRCUIT_BREAKER_FAILURES=5    # Phase 37: Consecutive failures before circuit opens (default 5)
# CIRCUIT_BREAKER_COOLDOWN_MS=30000  # Phase 37: Cooldown before retry (default 30s)
# ERROR_REPORT_WEBHOOK_URL=     # Phase 38: POST uncaught errors to this URL (e.g. Slack, PagerDuty)
# BASE_URL=                     # Phase 39: Base URL for smoke-test script (e.g. https://app.example.com)
#
# Phase 34: Production Hardening
# DISABLE_SECURITY_HEADERS=1   # Disable helmet security headers (dev only).
# SHUTDOWN_TIMEOUT_MS=10000    # Graceful shutdown wait in ms (default 10s).

# Phase 40 / Phase 36: Metrics & Prometheus
# ENABLE_METRICS=1             # Expose GET /metrics (Prometheus text format).
# METRICS_PATH=/metrics       # Custom path (default /metrics).
# METRICS_PROTECTED=1         # When 1, require METRICS_SECRET or ADMIN_API_KEY for /metrics.
# METRICS_SECRET=...           # Secret for ?secret= or Bearer when METRICS_PROTECTED=1.

# Phase 41: Request Timeouts & Retry
# BACKEND_TIMEOUT_MS=60000     # Backend fetch timeout (default 60s).
# BACKEND_RETRY_MAX=2          # Max retries for 5xx/network errors (default 2).
# BACKEND_RETRY_INITIAL_MS=1000  # Initial retry delay (default 1s).

# Phase 42: Granular CORS
# CORS_ORIGINS=https://app.example.com,https://admin.example.com  # Comma-separated. Unset = allow all (dev).

# Phase 43: Swarm Model Routing
# SWARM_MODEL_RESEARCHER=gpt-4o-mini    # Model for researcher specialist (default: request model).
# SWARM_MODEL_EXECUTOR=gpt-4o-mini      # Model for executor specialist.
# SWARM_MODEL_SYNTHESIZER=gpt-4o        # Model for synthesizer (final combine).

# Phase 44: Response Compression
# ENABLE_COMPRESSION=1         # gzip for JSON APIs (default: on in production).

# Phase 50: Storage abstraction — optional SQLite KV (same logical paths as JSON files)
# STORAGE_BACKEND=sqlite       # Uses data/storage-kv.db via optional better-sqlite3. Omit = JSON files (default).

# Phase 46 + 68: PostgreSQL KV — same logical paths as JSON files under STORAGE_PATH (storage_kv table)
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# PG_POOL_MAX=10               # Optional pool size cap
# Phase 68: teams, schedules, webhooks, notifications, agent-settings.json also use this KV when postgres/sqlite is enabled.

# Phase 51: Agent final response streaming (chunked SSE for smoother UI)
# STREAM_AGENT_FINAL=1         # When set, agent/swarm final text is sent in multiple SSE deltas.
# AGENT_STREAM_CHUNK_SIZE=320  # Characters per chunk (default 320).

# Phase 52: Execution audit retention (data/execution-audit.json)
# AUDIT_MAX_ENTRIES=1000       # Max entries to keep after trim (default 1000).
# AUDIT_RETENTION_DAYS=90    # Drop entries older than N days (optional).

# Phase 53: Backend fallback when primary returns 5xx/429 or connection fails
# FALLBACK_BACKEND=openai      # ollama | vllm | openai — requires that backend to be configured (e.g. OPENAI_API_KEY for openai).

# Phase 54 + 47: OpenTelemetry (optional)
# OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=siskel-bot
# OTEL_SERVICE_VERSION=0.1.0   # Phase 69: optional resource attribute service.version
# OTEL_AUTO_INSTRUMENT=0       # Set to 0 to disable HTTP + fetch (Undici) auto-instrumentation (default: on when OTEL_ENABLED=1)

# Phase 69: Deeper OpenTelemetry (sampling, pg, metrics exemplars)
# OTEL_TRACE_SAMPLING_RATIO=0.25   # Root trace sample rate 0..1 (alias: OTEL_TRACES_SAMPLER_ARG when ratio is intended)
# OTEL_TRACES_SAMPLER=traceidratio # Optional: always_on | always_off | traceidratio | parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25     # Ratio for traceidratio / parentbased_traceidratio
# OTEL_PG_INSTRUMENT=0             # Set to 0 to skip @opentelemetry/instrumentation-pg (default: on with auto-instrumentation)
# OTEL_PG_ENHANCED=1               # Richer db.statement on pg spans (higher cardinality)
# OTEL_PROMETHEUS_EXEMPLARS=1      # With ENABLE_METRICS=1: exemplar on http_request_duration_seconds +Inf (OpenMetrics)

# Phase 55: Tool validation before execute (default on). Set to 0 to skip and use legacy behavior.
# TOOL_VALIDATION_STRICT=0

# Phase 56: Golden-trace eval cases use target: "trace" and trace + expectedTool* fields (see data/eval-sets / tests).

# Phase 57: Require answers to cite search_context source ids or titles when RAG was used
# AGENT_REQUIRE_CITATIONS=1
# AGENT_CITATION_BRACKET_IDS=1   # With AGENT_REQUIRE_CITATIONS: require `[docId]` for at least one id from search_context snippets.
# AGENT_TOOL_RESULT_MAX_CHARS=0  # Max chars per tool result appended to context (0 = unlimited). Truncates long payloads between iterations.

# Phase 58: Stop agent loop when consecutive iterations repeat the same tool calls (default on)
# AGENT_STAGNATION_STOP=0

# Phase 59: Agent trajectory store + GET /api/agent/trajectory/:runId
# AGENT_TRAJECTORY_API=0           # Set to 0 to disable trajectory API
# AGENT_TRAJECTORY_TTL_MS=600000   # How long run snapshots are kept (default 10 min)
# AGENT_TRAJECTORY_MAX_STORE=100   # Max stored runs

# Phase 60: Deployment-wide default system instructions (agent mode + swarm). Appended to first system message, or new system message if none.
# Use your host's multiline env format. Truncated to AGENT_DEFAULT_SYSTEM_MAX_CHARS (default 8000, max 32000).
# AGENT_DEFAULT_SYSTEM=You are Siskel Bot. Prefer short answers unless the user asks for depth.
# AGENT_DEFAULT_SYSTEM_MAX_CHARS=8000

# Phase 61–62: Per-workspace agent prompt + approved memory (GET/PUT /api/workspaces/:id/agent-settings).
# Merged after Phase 60 default. Team workspaces store under the owner user id (resolveStorageUserId).
# WORKSPACE_AGENT_SYSTEM_MAX_CHARS=8000       # Max chars for defaultSystemPrompt (max 32000)
# WORKSPACE_AGENT_MEMORY_MAX_ITEMS=50         # Max bullet snippets
# WORKSPACE_AGENT_MEMORY_SNIPPET_MAX=2000     # Max chars per snippet
# WORKSPACE_AGENT_MEMORY_TOTAL_MAX=16000      # Total chars across all snippets (max 64000)
# WORKSPACE_AGENT_ALLOWED_TOOLS_MAX=32        # Max entries in workspace agent-settings allowedTools (cap 48)

# Phase 70: Audit log archive to S3-compatible storage
# AUDIT_S3_BUCKET=my-bucket
# AUDIT_S3_PREFIX=siskelbot-audit/
# AUDIT_S3_ENDPOINT=             # Optional (MinIO, R2, etc.)
# AUDIT_S3_FORCE_PATH_STYLE=1
# AUDIT_S3_SSE=AES256            # Optional server-side encryption
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AUDIT_ARCHIVE_TRIM_LOCAL=1     # After successful upload, trim local execution-audit.json

# Phase 71: Durable agent trajectories (json-path-store / Postgres path)
# AGENT_TRAJECTORY_DURABLE=1     # Set to 0 to use in-memory TTL only

# Phase 72: Knowledge chunking, reindex, URL fetch
# KNOWLEDGE_CHUNKING=1
# KNOWLEDGE_CHUNK_MAX_CHARS=4000
# KNOWLEDGE_CHUNK_OVERLAP=200
# KNOWLEDGE_MAX_CHUNKS_PER_DOC=50
# KNOWLEDGE_AUTO_EMBED=1         # Embed single-doc uploads without computeEmbedding
# KNOWLEDGE_URL_ALLOWLIST=raw.githubusercontent.com,https://example.com/docs/
# KNOWLEDGE_FETCH_MAX_BYTES=524288
# KNOWLEDGE_FETCH_TIMEOUT_MS=15000

# Phase 73: Swarm intent routing
# SWARM_INTENT_MODE=embedding   # default keyword; embedding uses OpenAI when key set

# Phase 75: Idempotency store (json-path-store)
# IDEMPOTENCY_TTL_MS=86400000

# Phase 77: Plugin config integrity
# PLUGINS_CONFIG_SHA256=        # sha256 hex of plugins/config.json contents
