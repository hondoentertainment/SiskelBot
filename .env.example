# =============================================================================
# SiskelBot — Environment Variables
# =============================================================================
# Copy to .env and uncomment/set values as needed.
# Lines starting with # are comments; uncommented lines show defaults.

# =============================================================================
# Backend
# =============================================================================
BACKEND=ollama
OLLAMA_URL=http://localhost:11434
# VLLM_URL=http://localhost:8000
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDINGS_BASE_URL=          # Custom base URL for embedding requests
# FALLBACK_BACKEND=                    # ollama | vllm | openai — fallback on 5xx/429
# MODEL_ROUTING=                       # Model routing configuration

# =============================================================================
# Server
# =============================================================================
PORT=3000
# LISTEN_HOST=127.0.0.1               # Bind HTTP server to this host
# WS_HOST=                             # WebSocket bind host
# NODE_ENV=production
# BASE_URL=https://your-domain.com     # For OAuth callbacks and smoke tests
# SHUTDOWN_TIMEOUT_MS=10000            # Graceful shutdown wait (default 10s)
# STATIC_CACHE_MAX_AGE=                # Static file cache max-age header
# STATIC_CACHE_MAX_AGE_MS=             # Static file cache max-age in ms
# ALLOW_INSECURE_PRODUCTION=           # Allow insecure settings in production

# Web UI — root behavior (see client/landing.html, client/index.html)
# UI_MARKETING_ROOT=1                  # GET / → 302 /landing.html (query preserved). Use ?app=1 to skip to app.
# UI_DEFAULT_APP=1                     # When marketing off: GET / → 302 /app/chat. With marketing on: used for ?app=1 skip target.

# =============================================================================
# Auth — API Keys
# =============================================================================
# API_KEY=your-secret-key              # Protects /v1/chat/completions
# API_KEY_PREVIOUS=                    # Previous key for zero-downtime rotation
# API_KEY_SCOPES=read,write            # Scopes for deployment API_KEY
# ADMIN_API_KEY=admin-secret           # Protects /admin and /api/admin/*
# ADMIN_API_KEY_PREVIOUS=              # Previous admin key for rotation
# ADMIN_IP_ALLOWLIST=                  # Comma-separated IPs allowed for admin
# USER_API_KEYS=key1:user1,key2:user2  # Per-user API keys (key:userId:scopes)
# USER_API_KEYS_PREVIOUS=              # Previous user keys for rotation
# RATE_LIMIT_PER_KEY=60                # Per-key rate limit (req/min)
# API_SUNSET_DATE=                     # Sunset date for deprecated API endpoints
# INTERNAL_SECRET=                     # Secret for internal service-to-service calls

# =============================================================================
# Auth — OAuth & SSO
# =============================================================================
# SESSION_SECRET=                      # Required for OAuth session persistence
# SESSION_SECRET_PREVIOUS=             # Previous session secret for rotation
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=                 # Override OAuth callback URL
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=                 # Override OAuth callback URL

# OIDC — OpenID Connect
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=
# OIDC_SCOPES=openid profile email

# SAML
# SAML_ENTRY_POINT=
# SAML_ISSUER=
# SAML_CERT=
# SAML_CALLBACK_URL=

# =============================================================================
# Rate Limiting
# =============================================================================
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60
# RATE_LIMIT_MAX_PER_USER=100          # Per-user limit when auth configured
# READ_RATE_LIMIT_MAX=                 # Rate limit for read-only endpoints
# STORAGE_RATE_LIMIT_MAX=              # Rate limit for storage operations
# WORKSPACE_RATE_LIMIT_MAX=            # Rate limit for workspace operations
# WORKSPACE_RATE_LIMIT_WINDOW_MS=      # Workspace rate limit window
# EMBEDDINGS_RATE_LIMIT_MAX=           # Rate limit for embedding requests
# KNOWLEDGE_INDEX_RATE_LIMIT_MAX=      # Rate limit for knowledge indexing

# =============================================================================
# Quotas
# =============================================================================
# QUOTA_ENABLED=                       # Enable quota enforcement
# QUOTA_TOKENS_PER_WORKSPACE=100000    # Tokens per workspace per period
# QUOTA_WORKSPACE_PERIOD_DAYS=30       # Quota period in days (default: 30)
# QUOTA_ADMIN_USER_IDS=user1,user2     # UserIds that bypass quota
# QUOTA_DEFAULT_LIMIT=                 # Default quota limit

# Per-tenant default quotas (can be overridden per-workspace via /api/v1/admin/quotas)
DEFAULT_REQUESTS_PER_MINUTE=60
DEFAULT_TOKENS_PER_DAY=1000000
DEFAULT_STORAGE_BYTES_MAX=1073741824

# =============================================================================
# Storage
# =============================================================================
# STORAGE_BACKEND=                     # json (default) | sqlite | postgres
# STORAGE_PATH=./data                  # Path for JSON file storage
# DATABASE_URL=postgresql://user:pass@host:5432/dbname  # When STORAGE_BACKEND=postgres
# PG_POOL_MAX=10                       # PostgreSQL pool size cap

# =============================================================================
# Security
# =============================================================================
# ENABLE_CSP=1                         # Content-Security-Policy (report-only)
# CSP_ENFORCE=1                        # Enforce CSP (block violations)
# DISABLE_SECURITY_HEADERS=            # Disable helmet headers (dev only)
# CORS_ORIGINS=https://app.example.com # Comma-separated allowed origins
# CORS_ALLOW_CREDENTIALS=              # Allow credentials in CORS

# =============================================================================
# Content Moderation (Wave 17B)
# =============================================================================
MODERATION_ENABLED=1
# MODERATION_API_URL=                  # optional: OpenAI-compatible moderation endpoint

# =============================================================================
# Backend Fetch
# =============================================================================
# BACKEND_TIMEOUT_MS=60000             # Backend fetch timeout (default 60s)
# BACKEND_RETRY_MAX=2                  # Max retries for 5xx/network errors
# BACKEND_RETRY_INITIAL_MS=1000        # Initial retry delay
# BACKEND_FETCH_KEEPALIVE=             # Enable HTTP keep-alive for backend
# BACKEND_KEEPALIVE_TIMEOUT_MS=        # Keep-alive timeout
# BACKEND_MAX_CONNECTIONS=             # Max concurrent backend connections

# =============================================================================
# Circuit Breaker
# =============================================================================
# CIRCUIT_BREAKER_FAILURES=5           # Consecutive failures before open
# CIRCUIT_BREAKER_COOLDOWN_MS=30000    # Cooldown before retry (default 30s)

# =============================================================================
# Compression
# =============================================================================
# ENABLE_COMPRESSION=1                 # gzip for JSON APIs

# =============================================================================
# Agent System
# =============================================================================
# MAX_AGENT_ITERATIONS=5               # Max tool-call loop iterations
# MAX_AGENT_TOOL_CALLS=30              # Stop after N tool executions (0=unlimited)
# AGENT_MAX_WALL_MS=120000             # Wall-clock budget per agent run (0=unlimited)
# AGENT_MAX_ITERATIONS_IGNORE_CLIENT=  # Ignore client maxIterations; use server value
# AGENT_CODE_EXECUTE=                  # Enable code execution tool (1 to enable)
# AGENT_DB_QUERY=                      # Enable database query tool (1 to enable)
# ALLOW_RECIPE_STEP_EXECUTION=1        # Enable execute_step tool
# AGENT_TOOL_TIMEOUT_MS=               # Per-tool execution timeout
# AGENT_TOOL_RESULT_MAX_CHARS=0        # Max chars per tool result (0=unlimited)
# AGENT_TOOLS_ALLOWLIST=               # Only these tools are available (comma-separated)
# AGENT_CONTEXT_DOC_MAX_CHARS=         # Max chars for context documents in agent

# Agent — System Prompt
# AGENT_DEFAULT_SYSTEM=                # Deployment-wide default system instructions
# AGENT_DEFAULT_SYSTEM_MAX_CHARS=8000  # Max chars for default system prompt

# Agent — Streaming
# STREAM_AGENT_FINAL=1                 # Stream agent final text via SSE chunks
# AGENT_STREAM_CHUNK_SIZE=320          # Characters per SSE chunk

# Agent — Citations
# AGENT_REQUIRE_CITATIONS=1
# AGENT_CITATION_BRACKET_IDS=1         # Require [docId] bracket citations

# Agent — Stagnation Detection
# AGENT_STAGNATION_STOP=1              # Stop on repeated tool calls (default on)

# Agent — Plan & Reflect
# AGENT_PLAN_REFLECT=1                 # Append reflection paragraph after agent loop

# Agent — Trajectory
# AGENT_TRAJECTORY_API=1               # Enable trajectory API (default on)
# AGENT_TRAJECTORY_TTL_MS=600000       # TTL for run snapshots (default 10 min)
# AGENT_TRAJECTORY_MAX_STORE=100       # Max stored runs
# AGENT_TRAJECTORY_DURABLE=1           # Persist trajectories to storage
# AGENT_TRAJECTORY_INDEX_MAX=          # Max trajectory index entries

# Agent — URL Fetch
# AGENT_FETCH_ALLOWLIST=               # Comma-separated hosts/prefixes for fetch
# AGENT_FETCH_MAX_BYTES=262144
# AGENT_FETCH_TIMEOUT_MS=12000
# AGENT_FETCH_MAX_OUTPUT_CHARS=24000

# Agent — Hooks
# AGENT_HOOKS_MODULE=./data/agent-hooks.mjs  # ESM with beforeToolCall/afterToolCall

# =============================================================================
# Swarm (Multi-Agent)
# =============================================================================
# ENABLE_AGENT_SWARM=1                 # Enable multi-agent swarm mode
# SWARM_PARALLEL_AGENTS=1              # Run researcher + executor in parallel
# SWARM_CLIENT_SPECIALISTS=1           # Allow client swarm specialist roster
# SWARM_MAX_SPECIALISTS=8              # Max specialists per swarm (clamped 1-12)
# SWARM_SPECIALISTS_ALLOWLIST=researcher,executor  # Allowed specialist names
# STREAM_SWARM_SYNTH=1                 # Stream synthesizer tokens over SSE

# Swarm — Model Routing
# SWARM_MODEL_RESEARCHER=gpt-4o-mini
# SWARM_MODEL_EXECUTOR=gpt-4o-mini
# SWARM_MODEL_SYNTHESIZER=gpt-4o

# Swarm — Intent
# SWARM_INTENT_MODE=keyword            # keyword | embedding
# SWARM_INTENT_EMBEDDING_MARGIN=       # Margin for embedding-based intent

# Swarm — Specialists
# SPECIALISTS_EXTRA_PATH=./data/specialists-extra.json

# =============================================================================
# Workspace Agent Settings
# =============================================================================
# WORKSPACE_AGENT_SYSTEM_MAX_CHARS=8000
# WORKSPACE_AGENT_MEMORY_MAX_ITEMS=50
# WORKSPACE_AGENT_MEMORY_SNIPPET_MAX=2000
# WORKSPACE_AGENT_MEMORY_TOTAL_MAX=16000
# WORKSPACE_AGENT_ALLOWED_TOOLS_MAX=32

# =============================================================================
# Knowledge & RAG
# =============================================================================
# KNOWLEDGE_CHUNKING=1
# KNOWLEDGE_CHUNK_MAX_CHARS=4000
# KNOWLEDGE_CHUNK_OVERLAP=200
# KNOWLEDGE_MAX_CHUNKS_PER_DOC=50
# KNOWLEDGE_AUTO_EMBED=1
# KNOWLEDGE_URL_ALLOWLIST=raw.githubusercontent.com
# KNOWLEDGE_FETCH_MAX_BYTES=524288
# KNOWLEDGE_FETCH_TIMEOUT_MS=15000
# KNOWLEDGE_DATA_DIR=                  # Custom knowledge data directory
# KNOWLEDGE_MAX_DOC_BYTES=             # Max bytes per document upload
# KNOWLEDGE_SEARCH_CACHE_MAX=          # Search result cache size
# KNOWLEDGE_SEARCH_CACHE_TTL_MS=       # Search cache TTL

# =============================================================================
# Observability — Metrics & Prometheus
# =============================================================================
# ENABLE_METRICS=1                     # Expose GET /metrics
# METRICS_PATH=/metrics
# METRICS_PROTECTED=1                  # Require auth for /metrics
# METRICS_SECRET=                      # Secret for metrics endpoint

# =============================================================================
# Observability — OpenTelemetry
# =============================================================================
# OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=siskel-bot
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_AUTO_INSTRUMENT=1               # HTTP + fetch auto-instrumentation
# OTEL_TRACE_SAMPLING_RATIO=0.25
# OTEL_TRACES_SAMPLER=traceidratio     # always_on | always_off | traceidratio | parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25
# OTEL_PG_INSTRUMENT=1                 # Instrument PostgreSQL
# OTEL_PG_ENHANCED=1                   # Richer db.statement on pg spans
# OTEL_PROMETHEUS_EXEMPLARS=1          # Exemplars on http_request_duration_seconds

# =============================================================================
# Observability — Tracing & Error Reporting
# =============================================================================
# RECORD_TRACES=                       # Enable trace recording
# REPLAY_BUFFER_SIZE=                  # Trace replay buffer size
# ERROR_REPORT_WEBHOOK_URL=            # POST uncaught errors to this URL
# ENABLE_MONITORING=                   # Enable health monitoring
# MONITORING_INTERVAL_MS=              # Monitoring check interval
# MONITORING_REPO=                     # GitHub repo for monitoring

# =============================================================================
# Observability — Usage & Analytics
# =============================================================================
# USAGE_ALERT_TOKENS=1000000           # Alert when tokens exceed threshold
# ANALYTICS_COST_PER_1K_INPUT=0.002    # $ per 1K input tokens
# ANALYTICS_COST_PER_1K_OUTPUT=0.006   # $ per 1K output tokens

# =============================================================================
# Audit
# =============================================================================
# AUDIT_MAX_ENTRIES=1000               # Max entries after trim
# AUDIT_RETENTION_DAYS=90              # Drop entries older than N days
# AUDIT_DELETE_AFTER_DAYS=             # Hard delete entries after N days
# AUDIT_ARCHIVE_AFTER_DAYS=            # Archive entries after N days

# Audit — S3 Archive
# AUDIT_S3_BUCKET=my-bucket
# AUDIT_S3_PREFIX=siskelbot-audit/
# AUDIT_S3_ENDPOINT=                   # MinIO, R2, etc.
# AUDIT_S3_REGION=                     # S3 region override
# AUDIT_S3_FORCE_PATH_STYLE=1
# AUDIT_S3_SSE=AES256                  # Server-side encryption
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AUDIT_ARCHIVE_TRIM_LOCAL=1           # Trim local after S3 upload

# =============================================================================
# Backup & Restore
# =============================================================================
# BACKUP_ADMIN_KEY=                    # Protects backup/restore API
# BACKUP_MAX_RETAINED=7               # Max backups to keep

# =============================================================================
# Scheduled Recipes
# =============================================================================
# ENABLE_SCHEDULED_RECIPES=1           # Enable in-process cron scheduler
# CRON_SECRET=                         # Protects GET /api/cron

# =============================================================================
# Initiative Engine (proactive autonomy)
# =============================================================================
# ENABLE_INITIATIVE_ENGINE=1           # Run proactive initiative cycles on a cadence (leader-only)
# INITIATIVE_CRON=*/15 * * * *         # How often to gather signals and propose initiatives
# INITIATIVE_WORKSPACES=default        # Comma-separated workspaces to run cycles for
# INITIATIVE_NOTIFY_SLACK=1            # Surface new proposals to Slack (requires SLACK_BOT_TOKEN)
# INITIATIVE_SLACK_CHANNEL=            # Channel for proposals (defaults to SLACK_DEFAULT_CHANNEL)

# =============================================================================
# Cost Budgets (per-workspace spend caps)
# =============================================================================
# WORKSPACE_BUDGET_USD=0               # Default per-workspace cap in USD (0 = unlimited)
# COST_BUDGET_PERIOD=month             # Budget window: "month" or "day"

# =============================================================================
# Plugins & Extensions
# =============================================================================
# PLUGINS_PATH=./plugins               # Path to plugins directory
# PLUGINS_CONFIG_SHA256=               # SHA-256 of plugins/config.json
# PLUGIN_REGISTRY_URL=                 # External plugin registry URL
# PLUGIN_SIGNING_KEY=                  # Plugin signature verification key
# PLUGIN_TIMEOUT_MS=                   # Plugin execution timeout
# PLUGIN_MEMORY_MB=                    # Plugin memory limit
# ALLOW_WEBHOOK_ACTIONS=1              # Enable webhook action plugin

# =============================================================================
# Webhooks & Notifications
# =============================================================================
# ALLOW_WEBHOOK_LOCALHOST=1            # Allow localhost webhook URLs (dev only)
# NOTIFICATIONS_INCLUDE_MESSAGE_SENT=  # Include message_sent events

# =============================================================================
# Email (SMTP)
# =============================================================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=                           # Sender email address
# EMAIL_DIGEST_ENABLED=               # Enable email digest notifications
# EMAIL_DIGEST_RECIPIENTS=            # Comma-separated digest recipients

# =============================================================================
# Integrations — GitHub
# =============================================================================
# GITHUB_TOKEN=ghp_...                 # For /api/github/* endpoints
# GITHUB_API_BASE=                     # Custom GitHub API base URL

# =============================================================================
# Integrations — Vercel
# =============================================================================
# VERCEL_TOKEN=                        # For /api/vercel/* endpoints
# VERCEL_API_BASE=                     # Custom Vercel API base URL

# =============================================================================
# Integrations — Slack
# =============================================================================
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=
# SLACK_WEBHOOK_URL=
# SLACK_DEFAULT_CHANNEL=

# =============================================================================
# Integrations — Discord
# =============================================================================
# DISCORD_BOT_TOKEN=
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_WEBHOOK_URL=

# =============================================================================
# Integrations — Jira
# =============================================================================
# JIRA_URL=https://your-org.atlassian.net
# JIRA_API_TOKEN=
# JIRA_EMAIL=
# JIRA_DEFAULT_PROJECT=

# =============================================================================
# Integrations — Linear
# =============================================================================
# LINEAR_API_KEY=
# LINEAR_DEFAULT_TEAM=

# =============================================================================
# Integrations — Search
# =============================================================================
# SEARCH_API=                          # External search API endpoint
# SEARCH_API_URL=                      # Alternative search API URL
# BRAVE_SEARCH_API_KEY=                # Brave Search API key
# GOOGLE_SEARCH_API_KEY=               # Google Custom Search API key
# GOOGLE_SEARCH_CX=                    # Google Custom Search engine ID

# =============================================================================
# Integrations — MCP (Model Context Protocol)
# =============================================================================
# MCP_SERVERS=                         # Comma-separated MCP server URLs

# =============================================================================
# Integrations — Redis
# =============================================================================
# REDIS_URL=redis://localhost:6379     # Redis for caching and pubsub

# =============================================================================
# Multi-Region / HA
# =============================================================================
# REGION_ID=                           # This instance's region identifier
# REGIONS=                             # Comma-separated region definitions
# REGION_HEALTH_TIMEOUT_MS=            # Health check timeout per region
# REGION_POLL_INTERVAL_MS=             # Region health poll interval
# INSTANCE_ID=                         # Unique instance identifier
# INSTANCE_NAME=                       # Human-readable instance name
# LEADER_TTL_MS=                       # Leader election TTL
# ENABLE_REPLICATION=                  # Enable storage replication
# REPLICATION_TIMEOUT_MS=              # Replication timeout
# FEDERATION_SECRET=                   # Secret for federated requests
# FEDERATION_HEALTH_TIMEOUT_MS=        # Federation health check timeout

# =============================================================================
# Idempotency
# =============================================================================
# IDEMPOTENCY_TTL_MS=86400000          # Idempotency key TTL (default 24h)

# =============================================================================
# Desktop (Electron)
# =============================================================================
# DESKTOP_PORT=38447                   # Default embedded server port
# NODE_BINARY=node                     # Path to Node if not on PATH
# DESKTOP_DEBUG=1                      # Forward server stdout/stderr to terminal

# =============================================================================
# CLI
# =============================================================================
# SISKELBOT_URL=http://localhost:3000
# SISKELBOT_API_KEY=                   # CLI authentication key
# PROJECT_DIR=                         # Project directory for CLI operations

# =============================================================================
# Log shipping (Phase 31.4)
# Forward structured logs to Datadog, Splunk HEC, Loki, Elasticsearch, or HTTP.
# =============================================================================
# LOG_SHIP_PROVIDER=                   # datadog | splunk | loki | elasticsearch | http
# LOG_SHIP_ENDPOINT=                   # Endpoint URL (required for non-datadog providers)
# LOG_SHIP_API_KEY=                    # Authentication token (DD-API-KEY, Splunk HEC token, etc.)
# LOG_SHIP_BATCH_SIZE=100              # Flush when batch reaches this size
# LOG_SHIP_FLUSH_INTERVAL_MS=5000      # Flush every N ms even if batch is not full
# LOG_SHIP_DD_TAGS=env:prod,service:siskelbot  # Datadog only: ddtags value

# =============================================================================
# Status page automation (Alertmanager webhook -> Statuspage.io)
# Bridges Prometheus alerts to a public status page. See docs/STATUS_PAGE.md.
# =============================================================================
STATUS_PAGE_ENABLED=0
STATUS_PAGE_PROVIDER=statuspage
STATUSPAGE_API_KEY=
STATUSPAGE_PAGE_ID=
# JSON map of alert name to Statuspage component ID, e.g.:
# STATUS_PAGE_COMPONENT_MAP={"SiskelBotProbeDown":"abc123","SiskelBotHighErrorRate":"def456"}
STATUS_PAGE_COMPONENT_MAP={}
ALERTMANAGER_WEBHOOK_SECRET=

# =============================================================================
# Stripe Billing (Wave 18A)
# =============================================================================
# STRIPE_SECRET_KEY=sk_test_...          # Stripe secret key (leave unset to disable billing)
# STRIPE_WEBHOOK_SECRET=whsec_...        # Stripe webhook signing secret
# STRIPE_PRO_PRICE_ID=price_...          # Stripe Price ID for the Pro plan
# STRIPE_ENTERPRISE_PRICE_ID=price_...   # Stripe Price ID for the Enterprise plan
# APP_BASE_URL=https://your-domain.com   # Public base URL used for default checkout success/cancel and portal return URLs
