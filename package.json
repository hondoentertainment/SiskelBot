{
  "name": "experimentagent",
  "version": "0.1.0",
  "description": "Siskel Bot — realtime streaming assistant proxy for Ollama, vLLM, or OpenAI",
  "type": "module",
  "main": "server.js",
  "bin": {
    "siskelbot": "./bin/siskelbot.js"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "prestart": "node scripts/build-client.mjs",
    "start": "node server.js",
    "cli": "node bin/siskelbot.js",
    "dev": "node --watch server.js",
    "desktop": "electron ./electron/main.cjs",
    "vendor:node-win": "node scripts/vendor-node-win.mjs all",
    "vendor:node-win:x64": "node scripts/vendor-node-win.mjs x64",
    "vendor:node-win:arm64": "node scripts/vendor-node-win.mjs arm64",
    "desktop:dist": "node scripts/ensure-node-vendor.mjs x64 && node scripts/stage-node-vendor.mjs x64 && electron-builder --win --x64",
    "desktop:dist:portable": "node scripts/ensure-node-vendor.mjs x64 && node scripts/stage-node-vendor.mjs x64 && electron-builder --win portable --x64",
    "desktop:dist:portable:arm64": "node scripts/ensure-node-vendor.mjs arm64 && node scripts/stage-node-vendor.mjs arm64 && electron-builder --win portable --arm64",
    "desktop:dist:arm64": "node scripts/ensure-node-vendor.mjs arm64 && node scripts/stage-node-vendor.mjs arm64 && electron-builder --win --arm64",
    "desktop:dist:all": "node scripts/ensure-node-vendor.mjs all && node scripts/stage-node-vendor.mjs x64 && electron-builder --win --x64 && node scripts/stage-node-vendor.mjs arm64 && electron-builder --win --arm64",
    "desktop:dist:mac": "electron-builder --mac",
    "desktop:dist:linux": "electron-builder --linux",
    "desktop:release": "node scripts/desktop-release-win.mjs x64",
    "desktop:release:arm64": "node scripts/desktop-release-win.mjs arm64",
    "verify:package-lock": "node scripts/verify-package-sync.mjs",
    "bootstrap:check": "node scripts/finite-boot-check.mjs",
    "dead-lib-scan": "node scripts/dead-lib-scan.mjs",
    "dead-route-scan": "node scripts/dead-route-scan.mjs",
    "wire-check": "node scripts/wire-check.mjs",
    "lint": "node scripts/syntax-check.mjs && node scripts/wire-check.mjs && eslint .",
    "lint:eslint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "c8 node scripts/run-tests.mjs",
    "test:ci": "c8 node scripts/run-tests.mjs --ci",
    "ci": "npm run lint && npm run test:ci",
    "smoke-test": "node scripts/smoke-test.js",
    "smoke-test:ci": "node scripts/smoke-test.js --live-only",
    "test:e2e": "npx playwright test",
    "test:e2e:api": "npx playwright test --project=api",
    "eval:ci": "node scripts/run-eval-ci.mjs",
    "eval:golden": "node scripts/run-golden-evals.mjs",
    "partner-check": "node scripts/phase63-partner-check.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:chaos": "node --test tests/chaos/*.test.js",
    "setup:production-env": "node scripts/setup-production-env.mjs",
    "apply:production-env": "node scripts/apply-production-env.mjs",
    "setup:stripe-products": "node scripts/setup-stripe-products.mjs",
    "check:production-env": "node scripts/check-production-env.mjs",
    "go-live:verify": "node scripts/go-live-verify.mjs",
    "go-live:verify:strict": "node scripts/go-live-verify.mjs --strict",
    "seed:preferences": "node scripts/seed-preference-dataset.mjs",
    "export:model-card": "node scripts/export-model-card.mjs",
    "branch-protection:apply": "node scripts/apply-branch-protection.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "postman:generate": "npm run openapi:generate && node scripts/openapi-to-postman.mjs --input=docs/openapi.yaml --output=postman/SiskelBot.postman_collection.json",
    "eval:live": "node scripts/run-eval-live.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@redis/client": "^1.6.1",
    "archiver": "^7.0.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "extract-zip": "^2.0.1",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "stripe": "^17.7.0",
    "undici": "^6.28.0",
    "ws": "^8.21.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1",
    "nodemailer": "^7.0.11",
    "playwright": "^1.62.0",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "c8": "^10.1.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "supertest": "^7.2.2"
  },
  "build": {
    "appId": "com.hondoentertainment.siskelbot",
    "productName": "Siskel Bot",
    "copyright": "Copyright © hondoentertainment",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!tests/**",
      "!**/*.test.js",
      "!**/node_modules/import-in-the-middle/**",
      "!**/node_modules/**/.editorconfig",
      "!**/node_modules/**/.eslintrc*",
      "!**/node_modules/**/.release-please-manifest.json",
      "!docs/**",
      "!scripts/**",
      "!release/**",
      "!vendor/**",
      "!.github/**",
      "!data/**",
      "!backups/**",
      "!node_modules/.cache/**"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "extraResources": [
      {
        "from": "vendor/node-win",
        "to": "node-win",
        "filter": [
          "node.exe"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "hondoentertainment",
      "repo": "SiskelBot"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}",
      "protocols": [
        {
          "name": "Siskel Bot",
          "schemes": [
            "siskelbot"
          ]
        }
      ],
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "protocols": [
        {
          "name": "Siskel Bot",
          "schemes": [
            "siskelbot"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}",
      "desktop": {
        "Name": "Siskel Bot",
        "Comment": "AI streaming assistant",
        "Categories": "Development;Utility;",
        "MimeType": "x-scheme-handler/siskelbot;"
      }
    }
  }
}
