{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plugin Pack Manifest",
  "description": "Schema for SiskelBot plugin pack manifests (Phase 49)",
  "type": "object",
  "required": ["id", "name", "version", "description", "author", "actions"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "author": { "type": "string", "minLength": 1 },
    "category": { "type": "string" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["webhook", "builtin"] },
          "config": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
