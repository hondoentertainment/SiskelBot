# SiskelBot air-gapped environment configuration template
#
# This template is optimized for disconnected deployments:
#   - No external URLs
#   - Internal LLM backends only (Ollama or vLLM on-prem)
#   - No telemetry, no external plugin registry
#   - Local file storage by default
#
# Copy to .env and edit the values marked REQUIRED before starting the service.

# --------------------------------------------------------------------
# Core server
# --------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Base URL used in generated links (no trailing slash)
PUBLIC_URL=http://siskelbot.internal:3000

# --------------------------------------------------------------------
# LLM backend (must be an internal, on-prem service)
# --------------------------------------------------------------------
# Supported: ollama | vllm
BACKEND=ollama

# Internal Ollama instance (default)
OLLAMA_URL=http://ollama.internal:11434

# Internal vLLM instance (if BACKEND=vllm)
# VLLM_URL=http://vllm.internal:8000

# --------------------------------------------------------------------
# Authentication (REQUIRED)
# --------------------------------------------------------------------
# API key clients must present in Authorization: Bearer <key>
API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Admin API key for /admin and /api/admin/*
ADMIN_API_KEY=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_STRING

# Session cookie secret (required for any session-based auth)
SESSION_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING

# Optional: map user-scoped API keys (comma-separated key:userId pairs)
# USER_API_KEYS=key1:alice,key2:bob

# --------------------------------------------------------------------
# Storage
# --------------------------------------------------------------------
# Default JSON file storage. Safe for air-gapped single-node deployments.
STORAGE_BACKEND=json
STORAGE_PATH=/opt/siskelbot/data

# For multi-node or larger deployments, use PostgreSQL on an internal host:
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgres://siskelbot:password@postgres.internal:5432/siskelbot

# Optional Redis for caching and pub/sub (internal only)
# REDIS_URL=redis://redis.internal:6379

# --------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------
ENABLE_METRICS=1
METRICS_PORT=9090
LOG_LEVEL=info

# Disable any outbound telemetry
DISABLE_TELEMETRY=1

# --------------------------------------------------------------------
# Features disabled in air-gapped mode
# --------------------------------------------------------------------
# External plugin registry must stay unset
# PLUGIN_REGISTRY_URL=

# External search disabled (no internet)
# SEARCH_API=

# External OAuth disabled
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# External chat integrations disabled
# SLACK_BOT_TOKEN=
# DISCORD_BOT_TOKEN=

# --------------------------------------------------------------------
# Agent tools (conservative defaults for locked-down environments)
# --------------------------------------------------------------------
# Code execution off by default in air-gapped mode
AGENT_CODE_EXECUTE=0

# Database query tool off by default
AGENT_DB_QUERY=0

# Workspace file tools optional, scoped to WORKSPACE_ROOT
WORKSPACE_FILE_TOOLS=0
WORKSPACE_ROOT=/opt/siskelbot/workspaces

# Restrict the exposed tool surface to only what is needed
# AGENT_TOOLS_ALLOWLIST=search_context,list_context,get_context_document,list_recipes,get_recipe

# --------------------------------------------------------------------
# Circuit breaker and timeouts
# --------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_COOLDOWN_MS=30000
REQUEST_TIMEOUT_MS=120000
