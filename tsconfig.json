{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "#lib/*": ["./lib/*"]
    }
  },
  "include": [
    "lib/agent-loop.js",
    "lib/agent-tools.js",
    "lib/storage.js",
    "lib/auth.js",
    "lib/tool-validation.js",
    "types/siskelbot.d.ts"
  ],
  "exclude": ["node_modules", "tests", "client", "vscode-extension"]
}
